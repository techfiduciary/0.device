# Copy this file to `secrets.toml` (same folder) and fill in what you have.
# Everything here is OPTIONAL — the app runs fully without it and degrades
# gracefully to simulation. `secrets.toml` is gitignored; never commit keys.

[paymongo]
# From https://developers.paymongo.com → Developers → API Keys.
# sk_test_... enables REAL GCash + Maya checkout flows in PayMongo's sandbox.
secret_key = ""

[stellar]
# Stellar TESTNET. Create accounts at https://laboratory.stellar.org (or fund
# any address with https://friendbot.stellar.org?addr=GXX...).
agent_secret = ""      # S... — the demo agent that pays
treasury_public = ""   # G... — where the payment lands
